<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.io/schema/zeebe/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.36.1">

  <bpmn:process id="TaskApprovalProcess" isExecutable="true">
    
    <bpmn:startEvent id="start" />
    
    <bpmn:userTask id="reviewTask" name="Review Task">
      <bpmn:extensionElements>
        <zeebe:taskHeader key="assignee" value="${assigneeId}" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    
    <bpmn:exclusiveGateway id="approved" />
    
    <bpmn:serviceTask id="notify" name="Send Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="end" />
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="reviewTask"/>
    <bpmn:sequenceFlow id="flow2" sourceRef="reviewTask" targetRef="approved"/>
    <bpmn:sequenceFlow id="flow3" sourceRef="approved" targetRef="notify"/>
    <bpmn:sequenceFlow id="flow4" sourceRef="notify" targetRef="end"/>
    
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TaskApprovalProcess">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewTask_di" bpmnElement="reviewTask">
        <dc:Bounds x="200" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved">
        <dc:Bounds x="350" y="100" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify">
        <dc:Bounds x="450" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="600" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      
      <!-- Sequence Flows Diagrams -->
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="136" y="118"/>
        <di:waypoint x="200" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="300" y="140"/>
        <di:waypoint x="350" y="125"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="400" y="125"/>
        <di:waypoint x="450" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="550" y="140"/>
        <di:waypoint x="600" y="118"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
